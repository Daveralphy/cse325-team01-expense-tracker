@page "/expenses"
@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ExpenseTracker.Data
@using ExpenseTracker.Services

@attribute [Authorize]
@rendermode InteractiveServer

@inject ExpenseService ExpenseService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>My Expenses</PageTitle>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4">
    <h1 class="h2 mb-0">My Expenses</h1>

    <div class="d-flex flex-column flex-sm-row gap-2">
        <button class="btn btn-outline-success"
                @onclick="ExportExpensesAsync"
                disabled="@(!FilteredExpenses.Any() || IsDateRangeInvalid || isExporting)">
            @if (isExporting)
            {
                <span class="spinner-border spinner-border-sm me-1"
                      role="status"
                      aria-hidden="true"></span>
                <span>Exporting...</span>
            }
            else
            {
                <span>Export CSV</span>
            }
        </button>

        <button class="btn btn-primary" @onclick="ShowCreateForm">
            @(isEditing ? "Close Form" : "+ Add Expense")
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(exportMessage))
{
    <div class="alert @(exportSucceeded ? "alert-success" : "alert-danger") 
                alert-dismissible fade show"
         role="alert">
        @exportMessage

        <button type="button"
                class="btn-close"
                aria-label="Close"
                @onclick="ClearExportMessage">
        </button>
    </div>
}

@if (isEditing)
{
    <div class="card mb-4 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 p-md-4">
            <h3 class="card-title h5 mb-3 text-primary fw-bold">
                @(currentExpense.Id == 0 ? "Add New Expense" : "Edit Expense")
            </h3>
            
            <EditForm Model="currentExpense" OnValidSubmit="SaveExpense">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small" />

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold small">Title</label>
                        <InputText @bind-Value="currentExpense.Title" class="form-control" placeholder="e.g. Groceries..." />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold small">Amount ($)</label>
                        <InputNumber @bind-Value="currentExpense.Amount" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold small">Category</label>
                        <InputSelect @bind-Value="currentExpense.Category" class="form-select">
                            <option value="Food">Food</option>
                            <option value="Housing">Housing</option>
                            <option value="Utilities">Utilities</option>
                            <option value="Entertainment">Entertainment</option>
                            <option value="Transport">Transport</option>
                            <option value="General">General</option>
                        </InputSelect>
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label fw-semibold small">Date</label>
                        <InputDate @bind-Value="currentExpense.Date" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold small">Note (Optional)</label>
                        <InputTextArea @bind-Value="currentExpense.Note" class="form-control" rows="2" placeholder="Add details or context..." />
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                    <button type="submit" class="btn btn-success fw-semibold">Save Expense</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (expenses == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2">Loading expenses...</p>
    </div>
}
else if (!expenses.Any())
{
    <div class="alert alert-info border-0 shadow-sm rounded-3">
        No expenses found. Click <strong>+ Add Expense</strong> above to record your first transaction!
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label for="expense-category-filter" class="form-label fw-semibold small">Category</label>
                    <InputSelect id="expense-category-filter"
                                 @bind-Value="selectedCategory"
                                 class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var category in AvailableCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label for="expense-start-date-filter" class="form-label fw-semibold small">From</label>
                    <InputDate id="expense-start-date-filter"
                               @bind-Value="startDate"
                               class="form-control" />
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label for="expense-end-date-filter" class="form-label fw-semibold small">To</label>
                    <InputDate id="expense-end-date-filter"
                               @bind-Value="endDate"
                               class="form-control" />
                </div>

                <div class="col-12 col-md-2">
                    <button type="button"
                            class="btn btn-outline-secondary w-100"
                            @onclick="ClearFilters"
                            disabled="@(!HasActiveFilters)">
                        Reset
                    </button>
                </div>
            </div>

            <div class="small text-muted mt-3" aria-live="polite">
                Showing @FilteredExpenses.Count() of @expenses.Count expense record(s).
            </div>
        </div>
    </div>

    @if (IsDateRangeInvalid)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3" role="alert">
            The From date must be earlier than or equal to the To date.
        </div>
    }
    else if (!FilteredExpenses.Any())
    {
        <div class="alert alert-info border-0 shadow-sm rounded-3" role="status">
            No expenses match the selected filters. Adjust the filters or select <strong>Reset</strong>.
        </div>
    }
    else
    {
        <div class="d-block d-md-none">
            <div class="d-flex flex-column gap-3">
                @foreach (var exp in FilteredExpenses)
                {
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">@exp.Title</h6>
                                    <small class="text-muted d-block mt-1">
                                        <i class="bi bi-calendar3 me-1"></i>@exp.Date.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                                <span class="fs-5 fw-bold text-success">$@exp.Amount.ToString("F2")</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(exp.Note))
                            {
                                <p class="small text-secondary mb-2 bg-light p-2 rounded-2">
                                    @exp.Note
                                </p>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">@exp.Category</span>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-warning" @onclick="() => EditExpense(exp)">Edit</button>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteExpense(exp.Id)">Delete</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="d-none d-md-block card border-0 shadow-sm rounded-3 overflow-hidden">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 15%;">Date</th>
                        <th style="width: 35%;">Title / Note</th>
                        <th style="width: 15%;">Category</th>
                        <th class="text-end" style="width: 15%;">Amount</th>
                        <th class="text-center" style="width: 20%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exp in FilteredExpenses)
                    {
                        <tr>
                            <td class="text-muted small">@exp.Date.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="fw-bold text-dark">@exp.Title</div>
                                @if (!string.IsNullOrWhiteSpace(exp.Note))
                                {
                                    <div class="small text-muted text-truncate" style="max-width: 300px;">@exp.Note</div>
                                }
                            </td>
                            <td><span class="badge bg-secondary">@exp.Category</span></td>
                            <td class="text-end fw-bold text-dark">$@exp.Amount.ToString("F2")</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => EditExpense(exp)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteExpense(exp.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<Expense>? expenses;
    private Expense currentExpense = new();
    private bool isEditing;
    private bool isExporting;
    private bool exportSucceeded;
    private string? exportMessage;
    private string userId = string.Empty;
    private string? selectedCategory;
    private DateTime? startDate;
    private DateTime? endDate;

    private IEnumerable<string> AvailableCategories =>
        expenses?
            .Select(expense => expense.Category)
            .Where(category => !string.IsNullOrWhiteSpace(category))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(category => category, StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<string>();

    private IEnumerable<Expense> FilteredExpenses =>
        expenses?
            .Where(expense =>
                (string.IsNullOrWhiteSpace(selectedCategory) ||
                 string.Equals(expense.Category, selectedCategory, StringComparison.OrdinalIgnoreCase)) &&
                (!startDate.HasValue || expense.Date.Date >= startDate.Value.Date) &&
                (!endDate.HasValue || expense.Date.Date <= endDate.Value.Date))
            .OrderByDescending(expense => expense.Date)
        ?? Enumerable.Empty<Expense>();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(selectedCategory) ||
        startDate.HasValue ||
        endDate.HasValue;

    private bool IsDateRangeInvalid =>
        startDate.HasValue &&
        endDate.HasValue &&
        startDate.Value.Date > endDate.Value.Date;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        userId = user.FindFirst(
                     System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                 ?? user.FindFirst("sub")?.Value
                 ?? string.Empty;

        await RefreshExpenses();
    }

    private async Task RefreshExpenses()
    {
        expenses = await ExpenseService.GetExpensesAsync(userId);
    }

    private void ShowCreateForm()
    {
        currentExpense = new Expense
        {
            UserId = userId,
            Date = DateTime.Today,
            Category = "General"
        };

        isEditing = !isEditing;
    }

    private void EditExpense(Expense expense)
    {
        currentExpense = new Expense
        {
            Id = expense.Id,
            Title = expense.Title,
            Amount = expense.Amount,
            Category = expense.Category,
            Date = expense.Date,
            Note = expense.Note,
            UserId = expense.UserId
        };

        isEditing = true;
    }

    private async Task SaveExpense()
    {
        await ExpenseService.SaveExpenseAsync(currentExpense, userId);
        isEditing = false;
        await RefreshExpenses();
    }

    private async Task DeleteExpense(int id)
    {
        await ExpenseService.DeleteExpenseAsync(id, userId);
        await RefreshExpenses();
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private async Task ExportExpensesAsync()
    {
        var expensesToExport = FilteredExpenses.ToList();

        if (expensesToExport.Count == 0 || IsDateRangeInvalid || isExporting)
        {
            return;
        }

        isExporting = true;
        exportMessage = null;

        try
        {
            var csvContent = GenerateCsv(expensesToExport);
            var fileName = $"expenses-{DateTime.Today:yyyy-MM-dd}.csv";

            await JSRuntime.InvokeVoidAsync(
                "downloadCsvFile",
                fileName,
                csvContent);

            exportSucceeded = true;
            exportMessage =
                $"{expensesToExport.Count} expense record(s) exported successfully.";
        }
        catch
        {
            exportSucceeded = false;
            exportMessage =
                "The expense records could not be exported. Please try again.";
        }
        finally
        {
            isExporting = false;
        }
    }

    private static string GenerateCsv(IEnumerable<Expense> expensesToExport)
    {
        var csv = new StringBuilder();

        csv.Append('\uFEFF');
        csv.AppendLine("Date,Title,Category,Amount,Note");

        foreach (var expense in expensesToExport)
        {
            var row = string.Join(",",
                EscapeCsvValue(expense.Date.ToString(
                    "yyyy-MM-dd",
                    CultureInfo.InvariantCulture)),
                EscapeCsvValue(expense.Title),
                EscapeCsvValue(expense.Category),
                EscapeCsvValue(expense.Amount.ToString(
                    "F2",
                    CultureInfo.InvariantCulture)),
                EscapeCsvValue(expense.Note));

            csv.AppendLine(row);
        }

        return csv.ToString();
    }

    private static string EscapeCsvValue(string? value)
    {
        var safeValue = value ?? string.Empty;

        if (safeValue.Contains('"'))
        {
            safeValue = safeValue.Replace("\"", "\"\"");
        }

        if (safeValue.Contains(',') ||
            safeValue.Contains('"') ||
            safeValue.Contains('\r') ||
            safeValue.Contains('\n'))
        {
            safeValue = $"\"{safeValue}\"";
        }

        return safeValue;
    }

    private void ClearExportMessage()
    {
        exportMessage = null;
    }

    private void ClearFilters()
    {
        selectedCategory = null;
        startDate = null;
        endDate = null;
    }
}
