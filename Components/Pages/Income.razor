@page "/income"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ExpenseTracker.Data
@using ExpenseTracker.Services

@attribute [Authorize]
@rendermode InteractiveServer

@inject IncomeService IncomeService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>My Income</PageTitle>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">My Income</h1>
        <p class="text-muted mb-0">Record and manage money you receive.</p>
    </div>
    <button class="btn btn-success" @onclick="ToggleCreateForm">
        @(showForm ? "Close Form" : "+ Add Income")
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(statusIsSuccess ? "alert-success" : "alert-danger")" role="alert">
        @statusMessage
    </div>
}

@if (showForm)
{
    <div class="card mb-4 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 p-md-4">
            <h2 class="h5 text-success fw-bold mb-3">
                @(currentIncome.Id == 0 ? "Add Income" : "Edit Income")
            </h2>

            <EditForm Model="currentIncome" OnValidSubmit="SaveIncome">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small" />

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold" for="incomeSource">Source</label>
                        <InputText id="incomeSource"
                                   @bind-Value="currentIncome.Source"
                                   class="form-control"
                                   placeholder="e.g. Salary or Freelance" />
                        <ValidationMessage For="() => currentIncome.Source" class="text-danger small" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold" for="incomeAmount">Amount ($)</label>
                        <InputNumber id="incomeAmount"
                                     @bind-Value="currentIncome.Amount"
                                     class="form-control" />
                        <ValidationMessage For="() => currentIncome.Amount" class="text-danger small" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label fw-semibold" for="incomeDate">Date</label>
                        <InputDate id="incomeDate"
                                   @bind-Value="currentIncome.Date"
                                   class="form-control" />
                        <ValidationMessage For="() => currentIncome.Date" class="text-danger small" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold" for="incomeNotes">Notes (Optional)</label>
                        <InputTextArea id="incomeNotes"
                                       @bind-Value="currentIncome.Notes"
                                       class="form-control"
                                       rows="3"
                                       placeholder="Add any helpful details" />
                        <ValidationMessage For="() => currentIncome.Notes" class="text-danger small" />
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        @(currentIncome.Id == 0 ? "Save Income" : "Save Changes")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (incomeItems is null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-success" role="status"></div>
        <p class="text-muted mt-2">Loading income records...</p>
    </div>
}
else if (incomeItems.Count == 0)
{
    <div class="alert alert-info border-0 shadow-sm">
        No income records yet. Select <strong>+ Add Income</strong> to create your first one.
    </div>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Total income</span>
            <span class="fs-4 fw-bold text-success">$@incomeItems.Sum(item => item.Amount).ToString("F2")</span>
        </div>
    </div>

    <div class="d-block d-md-none">
        <div class="d-flex flex-column gap-3">
            @foreach (var income in incomeItems)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-3">
                            <div>
                                <h2 class="h6 fw-bold mb-1">@income.Source</h2>
                                <small class="text-muted">@income.Date.ToString("MMM dd, yyyy")</small>
                            </div>
                            <span class="fw-bold text-success">$@income.Amount.ToString("F2")</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(income.Notes))
                        {
                            <p class="small bg-light rounded p-2 mt-3 mb-0">@income.Notes</p>
                        }

                        <div class="d-flex justify-content-end gap-2 border-top mt-3 pt-3">
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => EditIncome(income)">
                                Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteIncome(income.Id)">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-none d-md-block card border-0 shadow-sm overflow-hidden">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Source</th>
                    <th>Notes</th>
                    <th class="text-end">Amount</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var income in incomeItems)
                {
                    <tr>
                        <td class="text-muted">@income.Date.ToString("yyyy-MM-dd")</td>
                        <td class="fw-semibold">@income.Source</td>
                        <td>@(string.IsNullOrWhiteSpace(income.Notes) ? "—" : income.Notes)</td>
                        <td class="text-end fw-bold text-success">$@income.Amount.ToString("F2")</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => EditIncome(income)">
                                Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteIncome(income.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<IncomeTransaction>? incomeItems;
    private IncomeTransaction currentIncome = NewIncome();
    private string userId = string.Empty;
    private bool showForm;
    private string? statusMessage;
    private bool statusIsSuccess;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? user.FindFirst("sub")?.Value
            ?? string.Empty;

        await RefreshIncome();
    }

    private async Task RefreshIncome()
    {
        incomeItems = await IncomeService.GetIncomeAsync(userId);
    }

    private void ToggleCreateForm()
    {
        if (showForm)
        {
            CancelEdit();
            return;
        }

        currentIncome = NewIncome();
        statusMessage = null;
        showForm = true;
    }

    private void EditIncome(IncomeTransaction income)
    {
        currentIncome = new IncomeTransaction
        {
            Id = income.Id,
            Amount = income.Amount,
            Date = income.Date,
            Source = income.Source,
            Notes = income.Notes,
            UserId = income.UserId
        };

        statusMessage = null;
        showForm = true;
    }

    private async Task SaveIncome()
    {
        currentIncome.Source = currentIncome.Source.Trim();
        currentIncome.Notes = string.IsNullOrWhiteSpace(currentIncome.Notes)
            ? null
            : currentIncome.Notes.Trim();

        var wasNew = currentIncome.Id == 0;
        var saved = await IncomeService.SaveIncomeAsync(currentIncome, userId);

        if (!saved)
        {
            SetStatus("This income record could not be found or does not belong to your account.", false);
            return;
        }

        SetStatus(wasNew ? "Income record added." : "Income record updated.", true);
        showForm = false;
        currentIncome = NewIncome();
        await RefreshIncome();
    }

    private async Task DeleteIncome(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Delete this income record? This action cannot be undone.");

        if (!confirmed)
        {
            return;
        }

        var deleted = await IncomeService.DeleteIncomeAsync(id, userId);
        SetStatus(
            deleted ? "Income record deleted." : "This income record could not be deleted.",
            deleted);
        await RefreshIncome();
    }

    private void CancelEdit()
    {
        showForm = false;
        currentIncome = NewIncome();
    }

    private void SetStatus(string message, bool isSuccess)
    {
        statusMessage = message;
        statusIsSuccess = isSuccess;
    }

    private static IncomeTransaction NewIncome() => new()
    {
        Date = DateTime.Today
    };
}
