@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ExpenseTracker.Data
@using ExpenseTracker.Services
@using System.Globalization

@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable

@inject ExpenseService ExpenseService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Summary Dashboard</PageTitle>

<div class="mb-4">
    <h1 class="h2 mb-1">Summary Dashboard</h1>
    <p class="text-muted mb-0">
        View a summary of your monthly spending.
    </p>
</div>

@if (expenses is null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="text-muted mt-2">Loading dashboard...</p>
    </div>
}
else if (expenses.Count == 0)
{
    <div class="alert alert-info border-0 shadow-sm">
        No expenses are available yet.
        <a href="expenses" class="alert-link">Add an expense</a>
        to begin viewing your spending summary.
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total This Month</p>
                    <h2 class="h3 fw-bold text-primary mb-0">
                        @monthlyTotal.ToString("C")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Expenses This Month</p>
                    <h2 class="h3 fw-bold mb-0">
                        @monthlyExpenses.Count
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Largest Expense</p>

                    @if (largestExpense is not null)
                    {
                        <h2 class="h3 fw-bold text-danger mb-1">
                            @largestExpense.Amount.ToString("C")
                        </h2>
                        <small class="text-muted">@largestExpense.Title</small>
                    }
                    else
                    {
                        <h2 class="h3 fw-bold mb-0">$0.00</h2>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between mb-3">
                <div>
                    <h2 class="h5 fw-bold mb-1">Spending by Category</h2>
                    <p class="text-muted small mb-0">
                        @DateTime.Today.ToString("MMMM yyyy")
                    </p>
                </div>
            </div>

            @if (categorySummaries.Count == 0)
            {
                <p class="text-muted mb-0">
                    No expenses were recorded this month.
                </p>
            }
            else
            {
                @if (categorySummaries.Count > 0)
                {
                    <div class="row align-items-center g-4 mb-4">
                        <div class="col-12 col-md-5 text-center">
                            <div class="expense-pie-chart"
                                 style="@GetPieChartStyle()"
                                 role="img"
                                 aria-label="Pie chart showing monthly expenses by category">
                            </div>
                        </div>

                        <div class="col-12 col-md-7">
                            <h3 class="h6 fw-bold mb-3">Category Breakdown</h3>

                            <div class="d-flex flex-column gap-2">
                                @for (var index = 0; index < categorySummaries.Count; index++)
                                {
                                    var category = categorySummaries[index];

                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="category-color"
                                                  style="@($"background-color: {GetCategoryColor(index)}")">
                                            </span>

                                            <span>@category.Name</span>
                                        </div>

                                        <span class="fw-semibold">
                                            @category.Total.ToString("C")
                                            (@GetPercentage(category.Total).ToString("F0")%)
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="d-flex flex-column gap-3">
                    @foreach (var category in categorySummaries)
                    {
                        <div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-semibold">@category.Name</span>
                                <span>@category.Total.ToString("C")</span>
                            </div>

                            <div class="progress"
                                 role="progressbar"
                                 aria-label="@category.Name spending"
                                 aria-valuenow="@GetBarWidth(category.Total)"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 style="height: 22px;">
                                <div class="progress-bar"
                                     style="@($"width: {GetBarWidth(category.Total)}%")">
                                    @GetPercentage(category.Total).ToString("F0")%
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white border-0 pt-3 px-3 px-md-4">
            <h2 class="h5 fw-bold mb-0">Recent Expenses</h2>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in recentExpenses)
                        {
                            <tr>
                                <td class="text-muted">
                                    @expense.Date.ToString("yyyy-MM-dd")
                                </td>
                                <td class="fw-semibold">@expense.Title</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @expense.Category
                                    </span>
                                </td>
                                <td class="text-end fw-bold">
                                    @expense.Amount.ToString("C")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private List<Expense>? expenses;
    private List<Expense> monthlyExpenses = [];
    private List<Expense> recentExpenses = [];
    private List<CategorySummary> categorySummaries = [];

    private decimal monthlyTotal;
    private Expense? largestExpense;
    private string userId = string.Empty;

    private readonly CancellationTokenSource refreshCancellationTokenSource = new();
    private Task? refreshTask;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        userId =
            user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? user.FindFirst("sub")?.Value
            ?? string.Empty;

        await LoadDashboardAsync();

        refreshTask = RefreshDashboardPeriodicallyAsync(
            refreshCancellationTokenSource.Token);
    }

    private async Task LoadDashboardAsync()
    {
        expenses = await ExpenseService.GetExpensesAsync(userId);
        BuildDashboard();
    }

    private async Task RefreshDashboardPeriodicallyAsync(
        CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadDashboardAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        // Expected when the user leaves the dashboard.
        }
    }

    public async ValueTask DisposeAsync()
    {
        refreshCancellationTokenSource.Cancel();

        if (refreshTask is not null)
        {
            try
            {
                await refreshTask;
            }
            catch (OperationCanceledException)
            {
                // Expected during disposal.
            }
        }

        refreshCancellationTokenSource.Dispose();
    }

    private void BuildDashboard()
    {
        if (expenses is null)
        {
            return;
        }

        var currentMonth = DateTime.Today.Month;
        var currentYear = DateTime.Today.Year;

        monthlyExpenses = expenses
            .Where(expense =>
                expense.Date.Month == currentMonth &&
                expense.Date.Year == currentYear)
            .ToList();

        monthlyTotal = monthlyExpenses.Sum(expense => expense.Amount);

        largestExpense = monthlyExpenses
            .OrderByDescending(expense => expense.Amount)
            .FirstOrDefault();

        categorySummaries = monthlyExpenses
            .GroupBy(expense => expense.Category)
            .Select(group => new CategorySummary
            {
                Name = group.Key,
                Total = group.Sum(expense => expense.Amount)
            })
            .OrderByDescending(category => category.Total)
            .ToList();

        recentExpenses = expenses
            .OrderByDescending(expense => expense.Date)
            .ThenByDescending(expense => expense.Id)
            .Take(5)
            .ToList();
    }

    private decimal GetPercentage(decimal categoryTotal)
    {
        if (monthlyTotal == 0)
        {
            return 0;
        }

        return categoryTotal / monthlyTotal * 100;
    }

    private int GetBarWidth(decimal categoryTotal)
    {
        return (int)Math.Round(GetPercentage(categoryTotal));
    }

    private static readonly string[] ChartColors =
    [
        "#0d6efd",
        "#198754",
        "#ffc107",
        "#dc3545",
        "#6f42c1",
        "#0dcaf0",
        "#fd7e14",
        "#6c757d"
    ];

    private string GetCategoryColor(int index)
    {
        return ChartColors[index % ChartColors.Length];
    }

    private string GetPieChartStyle()
    {
        if (monthlyTotal <= 0 || categorySummaries.Count == 0)
        {
            return "background: #e9ecef;";
        }

        var segments = new List<string>();
        decimal currentPercentage = 0;

        for (var index = 0; index < categorySummaries.Count; index++)
        {
            var categoryPercentage =
                GetPercentage(categorySummaries[index].Total);

            var endPercentage = currentPercentage + categoryPercentage;

            segments.Add(
                $"{GetCategoryColor(index)} " +
                $"{currentPercentage.ToString("F2", CultureInfo.InvariantCulture)}% " +
                $"{endPercentage.ToString("F2", CultureInfo.InvariantCulture)}%");

            currentPercentage = endPercentage;
        }

        return $"background: conic-gradient({string.Join(", ", segments)});";
    }

    private class CategorySummary
    {
        public string Name { get; set; } = string.Empty;
        public decimal Total { get; set; }
    }
}